# Copy to .env, then: npx aws-cdk@2 deploy RoutingAPIStack
# One plain RPC URL per chain, straight to dRPC with a server key: https://lb.drpc.live/<slug>/<key>.
# Replace YOUR_DRPC_KEY below with the same value as DRPC_KEY (dotenv does not expand variables).
# A quote is 25 to 70 reads, so a shared or public endpoint that stalls turns into failed quotes.
# 4663 is Robinhood, where XSwap (crosschain) lives.
DRPC_KEY=YOUR_DRPC_KEY
WEB3_RPC_1=https://lb.drpc.live/ethereum/YOUR_DRPC_KEY
WEB3_RPC_10=https://lb.drpc.live/optimism/YOUR_DRPC_KEY
WEB3_RPC_42161=https://lb.drpc.live/arbitrum/YOUR_DRPC_KEY
WEB3_RPC_137=https://lb.drpc.live/polygon/YOUR_DRPC_KEY
WEB3_RPC_11155111=https://lb.drpc.live/sepolia/YOUR_DRPC_KEY
WEB3_RPC_42220=https://lb.drpc.live/celo/YOUR_DRPC_KEY
WEB3_RPC_56=https://lb.drpc.live/bsc/YOUR_DRPC_KEY
WEB3_RPC_43114=https://lb.drpc.live/avalanche/YOUR_DRPC_KEY
WEB3_RPC_8453=https://lb.drpc.live/base/YOUR_DRPC_KEY
WEB3_RPC_81457=https://lb.drpc.live/blast/YOUR_DRPC_KEY
WEB3_RPC_7777777=https://lb.drpc.live/zora/YOUR_DRPC_KEY
WEB3_RPC_324=https://lb.drpc.live/zksync/YOUR_DRPC_KEY
WEB3_RPC_480=https://lb.drpc.live/worldchain/YOUR_DRPC_KEY
WEB3_RPC_1301=https://lb.drpc.live/unichain-sepolia/YOUR_DRPC_KEY
WEB3_RPC_10143=https://lb.drpc.live/monad-testnet/YOUR_DRPC_KEY
WEB3_RPC_143=https://lb.drpc.live/monad-mainnet/YOUR_DRPC_KEY
WEB3_RPC_84532=https://lb.drpc.live/base-sepolia/YOUR_DRPC_KEY
WEB3_RPC_130=https://lb.drpc.live/unichain/YOUR_DRPC_KEY
WEB3_RPC_1868=https://lb.drpc.live/soneium/YOUR_DRPC_KEY
WEB3_RPC_196=https://lb.drpc.live/xlayer/YOUR_DRPC_KEY
WEB3_RPC_57073=https://lb.drpc.live/ink/YOUR_DRPC_KEY
WEB3_RPC_4326=https://lb.drpc.live/megaeth/YOUR_DRPC_KEY
WEB3_RPC_4663=https://lb.drpc.live/robinhood/YOUR_DRPC_KEY

# Comma list of chain ids to route. Empty routes every chain upstream does (needs multi-GB Lambdas).
ROUTED_CHAIN_IDS=

# Cap every Lambda's memory, for new AWS accounts limited to 512 MB
LAMBDA_MEMORY_CAP_MB=

# XSwap contracts (defaults are the live xgas.dev deployment)
XSWAP_INTENTS=
XSWAP_ASKS=
XSWAP_XMONEY=

# Everything else bin/app.ts reads for RoutingAPIStack (subgraph ids and keys, Tenderly, alerts).
# Optional for a first deploy; pool cache crons fail without the subgraph ones.
