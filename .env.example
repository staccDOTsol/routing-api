# Copy to .env, then: npx aws-cdk@2 deploy RoutingAPIStack
# One plain RPC URL per chain. These are public endpoints, fine to start with, rate limited under load.
# 4663 is Robinhood, where XSwap (crosschain) lives.
WEB3_RPC_1=https://ethereum-rpc.publicnode.com
WEB3_RPC_10=https://optimism-rpc.publicnode.com
WEB3_RPC_42161=https://arbitrum-one-rpc.publicnode.com
WEB3_RPC_137=https://polygon-bor-rpc.publicnode.com
WEB3_RPC_11155111=https://ethereum-sepolia-rpc.publicnode.com
WEB3_RPC_42220=https://forno.celo.org
WEB3_RPC_56=https://bsc-rpc.publicnode.com
WEB3_RPC_43114=https://avalanche-c-chain-rpc.publicnode.com
WEB3_RPC_8453=https://base-rpc.publicnode.com
WEB3_RPC_81457=https://rpc.blast.io
WEB3_RPC_7777777=https://rpc.zora.energy
WEB3_RPC_324=https://mainnet.era.zksync.io
WEB3_RPC_480=https://worldchain-mainnet.g.alchemy.com/public
WEB3_RPC_1301=https://sepolia.unichain.org
WEB3_RPC_10143=https://testnet-rpc.monad.xyz
WEB3_RPC_143=https://rpc.monad.xyz
WEB3_RPC_84532=https://sepolia.base.org
WEB3_RPC_130=https://mainnet.unichain.org
WEB3_RPC_1868=https://rpc.soneium.org
WEB3_RPC_196=https://rpc.xlayer.tech
WEB3_RPC_4663=https://rpc.mainnet.chain.robinhood.com

# Comma list of chain ids to route. Empty routes every chain upstream does (needs multi-GB Lambdas).
ROUTED_CHAIN_IDS=

# Cap every Lambda's memory, for new AWS accounts limited to 512 MB
LAMBDA_MEMORY_CAP_MB=

# XSwap contracts (defaults are the live xgas.dev deployment)
XSWAP_INTENTS=
XSWAP_ASKS=
XSWAP_XMONEY=

# Everything else bin/app.ts reads for RoutingAPIStack (subgraph ids and keys, Tenderly, alerts).
